{
  "name": "sdd-superpowers",
  "version": "0.4.0",
  "description": "Codex-only Spec-Driven Delivery plugin: Shape, Plan, Task Work Orders, Verify, Diagnose, Incident, and conditional Worktree/PR delivery.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "scaffold": "bash ./scripts/scaffold.sh",
    "verify": "bash ./scripts/verify.sh",
    "verify-contracts": "python3 ./scripts/verify-contract-fixtures.py ./evals/routing-contract-cases.json",
    "eval-live": "python3 ./scripts/run-live-evals.py",
    "check-docs": "bash ./scripts/check-docs.sh ./templates",
    "install": "bash ./scripts/install.sh",
    "install-local": "bash ./scripts/install.sh"
  }
}
