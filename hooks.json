{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./scripts/hooks/session.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./scripts/hooks/prompt.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node ./scripts/hooks/tool.mjs",
        "matcher": "Write|Delete|StrReplace|EditNotebook|Shell"
      }
    ]
  }
}
