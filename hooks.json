{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./scripts/hooks/session-start.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./scripts/hooks/before-submit-prompt.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node ./scripts/hooks/pre-tool-use.mjs",
        "matcher": "Write|Delete|StrReplace|EditNotebook|Shell"
      }
    ]
  }
}
