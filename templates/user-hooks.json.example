{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node /home/zcx/code/sdd-superpowers/scripts/hooks/session-start.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node /home/zcx/code/sdd-superpowers/scripts/hooks/before-submit-prompt.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node /home/zcx/code/sdd-superpowers/scripts/hooks/pre-tool-use.mjs",
        "matcher": "Write|Delete|StrReplace|EditNotebook|Shell"
      }
    ]
  }
}
