{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node /home/zcx/code/sdd-superpowers/scripts/hooks/session.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node /home/zcx/code/sdd-superpowers/scripts/hooks/prompt.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node /home/zcx/code/sdd-superpowers/scripts/hooks/tool.mjs",
        "matcher": "Write|Delete|StrReplace|EditNotebook|Shell"
      }
    ]
  }
}
